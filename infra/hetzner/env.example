# Production env. Copy to /etc/dripadvisor/env on the box and fill in.
# Never commit real values.

VERSION=v0.1.0

# Postgres
PG_USER=dripadvisor
PG_PASSWORD=                  # generate: openssl rand -base64 32
PG_DB=dripadvisor

# JWT
JWT_SIGNING_SECRET=            # generate: openssl rand -base64 48 (>= 32 bytes)
SESSION_TTL_HOURS=720

# Apple Sign-In
APPLE_BUNDLE_ID=com.dripadvisor.DripAdvisor
APPLE_TEAM_ID=                 # 10-char Apple Developer Team ID

# Object storage (MinIO local v1; swap for R2 keys at scale)
S3_ACCESS_KEY=                 # generate: openssl rand -hex 16
S3_SECRET_KEY=                 # generate: openssl rand -hex 32
S3_BUCKET=dripadvisor-prod
S3_REGION=us-east-1

# Gemini (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=
