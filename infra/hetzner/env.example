# Production env. Copy to /etc/dripadvisor/env on the box and fill in.
# Never commit real values.

VERSION=v0.1.0

# Public hostname for Caddy TLS. Stopgap: api.5-78-141-236.sslip.io
# (sslip.io resolves any IP-embedded subdomain → real Let's Encrypt cert
# without owning a domain). Swap to api.dripadvisor.app once DNS is ready.
API_HOST=api.5-78-141-236.sslip.io

# ─── Postgres (Neon serverless) ──────────────────────────────────────────────
# 1. Create project at https://console.neon.tech (free tier: 10 projects, 3 GB)
# 2. Choose region near the Hetzner box (e.g. eu-central-1 for Falkenstein)
# 3. Enable pgvector extension in Neon console (Database → Extensions → pgvector)
# 4. Copy "Pooled connection" string — Neon's pooler keeps connection count
#    bounded even with multiple backend replicas in Phase 2
# 5. Verify ?sslmode=require is in the URL (Neon enforces TLS)
#
# Format: postgres://<user>:<pass>@<host>-pooler.<region>.aws.neon.tech/<db>?sslmode=require
DATABASE_URL=

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SIGNING_SECRET=            # generate: openssl rand -base64 48 (>= 32 bytes)
SESSION_TTL_HOURS=720

# ─── Apple Sign-In ───────────────────────────────────────────────────────────
APPLE_BUNDLE_ID=com.dripadvisor.DripAdvisor
APPLE_TEAM_ID=                 # 10-char Apple Developer Team ID

# ─── Object storage (Cloudflare R2) ──────────────────────────────────────────
# 1. Cloudflare dashboard → R2 → Create bucket "dripadvisor-prod"
# 2. R2 → Manage R2 API tokens → Create API token
#    Permissions: Object Read & Write, scope to this bucket only
# 3. Copy the Account ID (top-right of R2 page) and the Access Key + Secret
# 4. Region "auto" (R2 ignores region but the AWS SDK requires a value)
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=dripadvisor-prod
S3_REGION=auto

# ─── Gemini ──────────────────────────────────────────────────────────────────
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ─── Camoufox ────────────────────────────────────────────────────────────────
# Self-hosted anti-detection browser on this same VPS.
# host.docker.internal resolves to the Docker host gateway (Linux + extra_hosts).
CAMOFOX_URL=http://host.docker.internal:9377

# ─── rembg ───────────────────────────────────────────────────────────────────
# Server-side background removal for scraped ecom images. Defaults to the
# rembg service inside this compose project (reachable as DNS name "rembg").
REMBG_URL=http://rembg:7000
