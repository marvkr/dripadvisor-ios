# Copy to .env for local dev. All values below are safe defaults for docker-compose.yml.

# HTTP server
HTTP_ADDR=:8080
ENV=dev

# Postgres
DATABASE_URL=postgres://dripadvisor:dev@localhost:54329/dripadvisor?sslmode=disable

# Redis
REDIS_ADDR=localhost:6380

# Object storage (MinIO for local, R2 for prod)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=dripadvisor-dev
S3_REGION=us-east-1
S3_USE_PATH_STYLE=true

# Auth
JWT_SIGNING_SECRET=dev-only-replace-me-at-least-32-bytes-long-plz
APPLE_BUNDLE_ID=com.dripadvisor.DripAdvisor
APPLE_TEAM_ID=SJ9MSN5XRH
SESSION_TTL_HOURS=720

# Gemini — fill in from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Free tier quotas
FREE_TRYONS_PER_WEEK=3
FREE_STYLIST_REPLIES_PER_WEEK=2
